# ========================================================
# Netflix AI Watch Spaces - Backend Environment (Node.js)
# ========================================================

# Server Port
PORT=5000

# Environment Mode
NODE_ENV=production

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/watchspaces?retryWrites=true&w=majority
MONGODB_URI=""

# Frontend Origin URL for CORS
# In production: https://frontend-ali-charolia.vercel.app
FRONTEND_URL="https://frontend-ali-charolia.vercel.app"

# JWT Secret for Session Tokens
JWT_SECRET="replace-with-a-random-secure-64-character-jwt-secret-in-production"

# OpenAI-Compatible API Key (Optional for live LLM Co-Pilot generation)
# Leave blank to use the deterministic temporal retrieval engine (no credit card needed)
OPENAI_API_KEY=""
OPENAI_API_BASE="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
