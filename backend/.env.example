# ========================================================
# Netflix AI Watch Spaces - Backend Environment Variables
# Project ID: PROJ-NETF-260919
# ========================================================

# Server Port (assigned by Render, Railway, Fly.io, or 5000 for local)
PORT=5000

# Environment Mode (development | production)
NODE_ENV=production

# MongoDB Atlas Connection String (Required in production)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/watchspaces?retryWrites=true&w=majority
MONGODB_URI=""

# Frontend URL(s) for CORS Whitelist (comma-separated if multiple)
# Example: https://frontend-ali-charolia.vercel.app
FRONTEND_URL="https://frontend-ali-charolia.vercel.app"

# JWT Secret for Session & Authentication Tokens (64+ random characters)
JWT_SECRET="replace-with-a-random-secure-64-character-jwt-secret-in-production"

# OpenAI-Compatible API Key (Optional: for live LLM Co-Pilot generation)
# Leave blank to use the built-in deterministic temporal retrieval engine
OPENAI_API_KEY=""
OPENAI_API_BASE="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
