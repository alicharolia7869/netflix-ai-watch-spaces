# ========================================================
# Netflix AI Watch Spaces - Environment Configuration
# Project ID: PROJ-NETF-260919
# ========================================================

PROJECT_NAME="Netflix AI Watch Spaces"
PROJECT_ID="PROJ-NETF-260919"
VERSION="1.0.0"
ENVIRONMENT="development"

# Database Configuration
# Primary: PostgreSQL (production / standard dev)
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/netflix_ai_spaces"
# Fallback: SQLite (guarantees local dev works without running local PostgreSQL instance)
SQLITE_FALLBACK_URL="sqlite:///./watchspaces.db"

# Security & Authentication
JWT_SECRET="dev-super-secret-key-netflix-ai-spaces-replace-in-production-260919"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration (OpenAI-compatible LLM)
OPENAI_API_KEY=""
OPENAI_API_BASE="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_MOCK_FALLBACK=true

# Server & Network
PORT=8000
HOST="127.0.0.1"

# Frontend API Configuration (Vite)
# In local dev: Leave empty to proxy through Vite dev server
# In Vercel production: Point to your deployed FastAPI backend (e.g. https://api.yourdomain.com)
VITE_API_URL=""

# Backend CORS Allowed Origins (Comma-separated or JSON array)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://frontend-ali-charolia.vercel.app,https://frontend-snowy-nine-54.vercel.app"

